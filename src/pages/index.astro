---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import ProductCard from '../components/ProductCard.astro';
import ContactForm from '../components/ContactForm.astro';
import RefBadge from '../components/RefBadge.astro';
import Logo from '../components/LogoWordmark.svg';
import heroRecorte from '../../assets/hero/claudia-recorte.png';
import { destacados, foto } from '../data/productos';
import { site, marcas, waLink } from '../data/site';

import mbComedor from '../../assets/moodboard/02-comedor-mobiliario.jpg';
import mbDormitorio from '../../assets/moodboard/03-dormitorio.jpg';
import mbCocina from '../../assets/moodboard/04-cocina.jpg';
import mbExterior from '../../assets/moodboard/05-exterior.jpg';
import mbInteriorismo from '../../assets/moodboard/06-interiorismo-reformas.jpg';

const heroFondo = foto('claudia/claudia-01-drom');
const colecciones = [
  { t: 'Sofás', h: '/sofas', img: foto('beatrice/beatrice-01'), ref: false, d: 'Rinconeras, chaise longue, modulares, relax y sofás cama.' },
  { t: 'Salones', h: '/salones', img: foto('mauro/mauro-03'), ref: false, d: 'Composiciones completas para la zona de estar.' },
  { t: 'Mobiliario', h: '/mobiliario', img: mbComedor, ref: true, d: 'Mesas, sillas, aparadores y butacas.' },
  { t: 'Dormitorios', h: '/dormitorios', img: mbDormitorio, ref: true, d: 'Camas, cabeceros y almacenaje.' },
  { t: 'Cocinas', h: '/cocinas', img: mbCocina, ref: true, d: 'Distribuciones y materiales para el día a día.' },
  { t: 'Exterior', h: '/exterior', img: mbExterior, ref: true, d: 'Terrazas y jardines como parte de la casa.' },
];
const pasos = [
  ['01', 'Ven al showroom', 'Siéntate, compara modelos y toca los tejidos en San Sebastián de los Reyes.'],
  ['02', 'Elige medida y acabado', 'Te ayudamos con la composición, el tapizado y el color que encajan con tu salón.'],
  ['03', 'Lo preparamos', 'Gestionamos el pedido con el fabricante y te mantenemos informado.'],
  ['04', 'Lo disfrutas en casa', 'Coordinamos la entrega para que solo tengas que estrenarlo.'],
];
---
<Base
  overlay
  title="UNIK Sofás y Mobiliario · San Sebastián de los Reyes"
  description="Showroom de sofás, mobiliario e interiorismo en San Sebastián de los Reyes (Madrid). Descubre nuestras colecciones y ven a verlas en persona."
>
  <!-- 1. Hero: foto a sangre, wordmark gigante detrás del sofá recortado -->
  <section class="hero" aria-labelledby="hero-titulo">
    <div class="hero__media" aria-hidden="true">
      <Image src={heroFondo} alt="" widths={[640, 1024, 1600, 2400]} sizes="100vw" class="hero__layer hero__bg" loading="eager" fetchpriority="high" />
    </div>
    <h1 id="hero-titulo" class="hero__marca">
      <span class="sr-only">UNIK Sofás, San Sebastián de los Reyes. Espacios para vivir. Diseño para sentir.</span>
      <span class="hero__logo" aria-hidden="true"><Logo /></span>
    </h1>
    <div class="hero__media hero__media--front" aria-hidden="true">
      <Image src={heroRecorte} alt="" widths={[640, 1024, 1600, 2400]} sizes="100vw" class="hero__layer hero__cut" loading="eager" />
    </div>

    <div class="hero__pie">
      <p class="hero__claim" aria-hidden="true">
        <span class="ln"><span>Espacios para vivir.</span></span>
        <span class="ln"><span><em>Diseño para sentir.</em></span></span>
      </p>
      <a href="#intro" class="hero__scroll" aria-label="Seguir leyendo"><span></span></a>
      <div class="hero__dcha">
        <span class="ln"><a href="/visitanos" class="hero__cta" data-track="cta_reserva_visita" data-ubicacion="hero">Reserva tu visita <span aria-hidden="true">→</span></a></span>
        <span class="ln hero__credito"><span>Sofá Claudia · Bobbio</span></span>
      </div>
    </div>
  </section>

  <!-- 2. Franja de confianza -->
  <section class="trust">
    <div class="wrap trust__in">
      <span class="trust__lbl">Trabajamos con</span>
      <ul>
        {marcas.map((m) => <li class:list={{ pend: !m.confirmada }}>{m.nombre}</li>)}
      </ul>
    </div>
  </section>

  <!-- 3. Intro -->
  <section class="section" id="intro">
    <div class="wrap intro reveal">
      <span class="eyebrow">UNIK</span>
      <h2>El diseño empieza en cada detalle.</h2>
      <p class="lead">En UNIK creemos que un espacio bien pensado cambia la forma de vivirlo. Seleccionamos mobiliario, sofás y propuestas para cada estancia, combinando estética, comodidad y funcionalidad. Desde una pieza especial hasta la transformación de un ambiente, queremos ayudarte a crear una casa que hable de ti.</p>
      <a href="/nosotros" class="link">Conócenos</a>
    </div>
  </section>

  <!-- 4. Colecciones -->
  <section class="section section--surface">
    <div class="wrap">
      <div class="head reveal">
        <div>
          <span class="eyebrow">Colecciones</span>
          <h2>Cada estancia, su propuesta.</h2>
        </div>
        <a href="/sofas" class="btn btn--ghost">Descubrir colecciones</a>
      </div>
      <div class="grid grid-3 cols">
        {colecciones.map((c) => (
          <a href={c.h} class="col reveal">
            <div class="col__img">
              <Image src={c.img} alt={c.t} widths={[480, 800]} sizes="(max-width: 600px) 100vw, 33vw" class="cover" />
              {c.ref && <RefBadge />}
            </div>
            <h3>{c.t}</h3>
            <p>{c.d}</p>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- 5. Sofás destacados -->
  <section class="section">
    <div class="wrap">
      <div class="head reveal">
        <div>
          <span class="eyebrow">En el showroom</span>
          <h2>El sofá alrededor del que sucede todo.</h2>
        </div>
        <a href="/sofas" class="btn btn--ghost">Ver todos los sofás</a>
      </div>
      <div class="grid grid-3">
        {destacados.slice(0, 6).map((p) => <ProductCard p={p} />)}
      </div>
    </div>
  </section>

  <!-- 6. Cómo trabajamos -->
  <section class="section section--dark">
    <div class="wrap">
      <span class="eyebrow">Cómo trabajamos</span>
      <h2 class="reveal">De la idea a tu salón, sin complicaciones.</h2>
      <ol class="pasos grid grid-4">
        {pasos.map(([n, t, d]) => (
          <li class="reveal"><span class="pasos__n">{n}</span><h3>{t}</h3><p>{d}</p></li>
        ))}
      </ol>
    </div>
  </section>

  <!-- 7. Interiorismo y reformas -->
  <section class="section">
    <div class="wrap split">
      <div class="split__img reveal">
        <Image src={mbInteriorismo} alt="Salón abierto con cocina y comedor integrados" widths={[600, 1000]} sizes="(max-width: 900px) 100vw, 50vw" class="cover" />
        <RefBadge />
      </div>
      <div class="split__txt reveal">
        <span class="eyebrow">Interiorismo y reformas</span>
        <h2>Espacios con sentido. Espacios con identidad.</h2>
        <p class="lead">El interiorismo empieza escuchando: cómo vives, qué necesitas y qué quieres sentir en tu casa. A partir de ahí, mobiliario, materiales, distribución y luz trabajan juntos.</p>
        <div class="btns">
          <a href="/interiorismo" class="btn">Interiorismo</a>
          <a href="/reformas" class="btn btn--ghost">Reformas</a>
        </div>
      </div>
    </div>
  </section>

  <!-- 8. Materiales -->
  <section class="section section--arena">
    <div class="wrap split split--rev">
      <div class="split__img reveal">
        <Image src={foto('beatrice/beatrice-08')} alt="Detalle del tejido de un sofá" widths={[600, 1000]} sizes="(max-width: 900px) 100vw, 50vw" class="cover" />
      </div>
      <div class="split__txt reveal">
        <span class="eyebrow">Materiales y tejidos</span>
        <h2>Materiales que marcan la diferencia.</h2>
        <p class="lead">Cada modelo admite distintos tejidos, colores y acabados. En el showroom puedes ver y tocar los muestrarios y comparar con calma.</p>
        <a href={waLink('Hola UNIK, quiero información sobre tejidos y acabados.')} class="btn btn--wa" target="_blank" rel="noopener" data-track="clic_whatsapp" data-ubicacion="home_materiales">Pregunta por WhatsApp</a>
      </div>
    </div>
  </section>

  <!-- 9. Showroom + contacto -->
  <section class="section" id="contacto">
    <div class="wrap split">
      <div class="split__txt reveal">
        <span class="eyebrow">Visítanos</span>
        <h2>Ven a descubrir UNIK en persona.</h2>
        <p class="lead">Te esperamos en San Sebastián de los Reyes para conocer nuestras propuestas y conversar sobre tu espacio.</p>
        <address>
          <strong>{site.direccion.calle}</strong><br />
          {site.direccion.cp} {site.direccion.ciudad} ({site.direccion.provincia})<br />
          {site.horario.map((h) => <span>{h.dias}: {h.horas}<br /></span>)}
          <a href={site.telefonoHref} data-track="clic_telefono" data-ubicacion="home">{site.telefono}</a>
        </address>
        <a href={site.mapsUrl} class="link" target="_blank" rel="noopener" data-track="clic_como_llegar" data-ubicacion="home">Cómo llegar</a>
      </div>
      <div class="reveal">
        <ContactForm titulo="Hablemos de tu próximo proyecto." />
      </div>
    </div>
  </section>
</Base>

<style>
  /* ---------- Hero ---------- */
  .hero { position: relative; height: 100vh; height: 100svh; min-height: 560px; overflow: hidden; background: #8f978d; isolation: isolate; }
  .hero__media { position: absolute; inset: 0; z-index: 0; }
  .hero__media--front { z-index: 2; pointer-events: none; }
  .hero :global(.hero__layer) { width: 100%; height: 100%; object-fit: cover; object-position: 50% 50%; animation: hero-zoom 2.6s var(--ease-out) both; }

  .hero__marca { position: absolute; z-index: 1; left: 0; right: 0; bottom: 33%; margin: 0; display: flex; justify-content: center; }
  .hero__logo { display: block; width: min(90vw, 150svh); color: var(--blanco-roto); animation: hero-wordmark 1.6s 0.25s var(--ease-out) both; }
  .hero__logo :global(svg) { display: block; width: 100%; height: auto; }

  .hero__pie {
    position: absolute; z-index: 3; left: 0; right: 0; bottom: 0;
    display: grid; grid-template-columns: 1fr auto 1fr; align-items: end; gap: 24px;
    padding: 0 calc(var(--gutter) + 72px) clamp(24px, 4vh, 44px) var(--gutter); color: var(--tinta);
  }
  .hero__claim { margin: 0; font-family: var(--font-display); font-weight: 340; font-size: clamp(1.3rem, 2.1vw, 2rem); line-height: 1.08; letter-spacing: -0.01em; }
  .hero__claim em { font-style: italic; }
  .hero__dcha { justify-self: end; text-align: right; display: grid; gap: 6px; }
  .hero__cta { display: inline-block; font-size: 0.78rem; letter-spacing: 0.16em; text-transform: uppercase; font-weight: 500; text-decoration: none; background: var(--blanco-roto); color: var(--tinta); padding: 12px 16px; transition: background 0.3s, color 0.3s; }
  .hero__cta:hover { background: var(--terracota); color: var(--blanco-roto); }
  .hero__credito { font-size: 0.72rem; letter-spacing: 0.08em; color: var(--tinta); opacity: 0.75; }

  .hero__scroll { display: block; width: 1px; height: 56px; background: rgb(22 20 18 / 0.25); position: relative; overflow: hidden; }
  .hero__scroll span { position: absolute; left: 0; top: 0; width: 1px; height: 40%; background: var(--tinta); animation: hero-scroll 2.2s 1.8s var(--ease-out) infinite; }

  /* Texto por líneas */
  .hero .ln { display: block; overflow: hidden; }
  .hero .ln > * { display: inline-block; animation: hero-line 1.1s var(--ease-out) both; }
  .hero .ln:nth-child(1) > * { animation-delay: 0.9s; }
  .hero .ln:nth-child(2) > * { animation-delay: 1.02s; }
  .hero__dcha .ln:nth-child(1) > * { animation-delay: 1.15s; }
  .hero__dcha .ln:nth-child(2) > * { animation-delay: 1.25s; }

  @keyframes hero-zoom { from { transform: scale(1.1); } to { transform: none; } }
  @keyframes hero-wordmark { from { clip-path: inset(100% 0 0 0); transform: translateY(12%); } to { clip-path: inset(0 0 0 0); transform: none; } }
  @keyframes hero-line { from { transform: translateY(110%); } to { transform: none; } }
  @keyframes hero-scroll { 0% { transform: translateY(-100%); } 60%, 100% { transform: translateY(260%); } }

  /* Pantallas verticales (móvil y tablet): logo más arriba, claim sobre la pared */
  @media (max-width: 760px), (orientation: portrait) {
    .hero { height: 100svh; }
    .hero :global(.hero__layer) { object-position: 52% 50%; }
    .hero__marca { bottom: 43.5%; }
    .hero__logo { width: 92vw; }
    /* Deja sitio a la barra inferior fija */
    .hero__pie { position: static; display: block; padding: 0; }
    .hero__claim {
      position: absolute; z-index: 3; top: calc(72px + 5svh); right: var(--gutter); max-width: 80%;
      text-align: right; font-size: clamp(1.45rem, 6.6vw, 1.9rem);
    }
    .hero__scroll { display: none; }
    .hero__dcha { position: absolute; z-index: 3; right: var(--gutter); bottom: calc(68px + 2.5svh + env(safe-area-inset-bottom)); }
  }
  @media (min-width: 761px) and (orientation: portrait) {
    .hero__dcha { bottom: 4svh; right: calc(var(--gutter) + 72px); }
    .hero__claim { font-size: clamp(1.9rem, 4vw, 2.6rem); max-width: 60%; }
  }
  @media (prefers-reduced-motion: reduce) {
    .hero :global(.hero__layer), .hero__logo, .hero .ln > *, .hero__scroll span { animation: none; }
  }

  .trust { border-bottom: 1px solid var(--line); }
  .trust__in { display: flex; align-items: center; gap: 32px; padding-block: 22px; overflow-x: auto; }
  .trust__lbl { font-size: 0.7rem; letter-spacing: 0.2em; text-transform: uppercase; color: var(--nogal); white-space: nowrap; }
  .trust ul { display: flex; gap: clamp(20px, 3vw, 44px); list-style: none; margin: 0; padding: 0; }
  .trust li { font-family: var(--font-display); font-weight: 800; font-size: 1.05rem; white-space: nowrap; color: var(--ink-soft); }
  .trust li.pend { opacity: 0.45; }

  .intro { max-width: 860px; }
  .head { display: flex; justify-content: space-between; align-items: flex-end; gap: 24px; flex-wrap: wrap; margin-bottom: clamp(28px, 4vw, 48px); }
  .head h2 { margin: 0; max-width: 18ch; }

  .col { text-decoration: none; }
  .col__img { position: relative; aspect-ratio: 4 / 5; overflow: hidden; margin-bottom: 16px; }
  .col__img :global(img) { transition: transform 0.8s var(--ease); }
  .col:hover .col__img :global(img) { transform: scale(1.04); }
  .col h3 { margin-bottom: 4px; }
  .col p { color: var(--ink-soft); font-size: 0.95rem; }

  .pasos { list-style: none; padding: 0; margin: 48px 0 0; }
  .pasos li { border-top: 1px solid #2a3846; padding-top: 24px; }
  .pasos__n { font-family: var(--font-display); font-weight: 900; font-size: 2.4rem; color: var(--piedra); display: block; margin-bottom: 12px; }
  .pasos p { color: #c9c2b8; }

  .split { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(32px, 6vw, 96px); align-items: center; }
  .split--rev .split__img { order: 2; }
  .split__img { position: relative; aspect-ratio: 4 / 5; overflow: hidden; }
  address { font-style: normal; margin: 24px 0; line-height: 1.8; }
  @media (max-width: 900px) {
    .split { grid-template-columns: 1fr; }
    .split--rev .split__img { order: 0; }
    .split__img { aspect-ratio: 4 / 3; }
  }
</style>
