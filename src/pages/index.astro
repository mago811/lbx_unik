---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import ContactForm from '../components/ContactForm.astro';
import RefBadge from '../components/RefBadge.astro';
import ListaTipografica from '../components/ListaTipografica.astro';
import Logo from '../components/LogoWordmark.svg';
import heroRecorte from '../../assets/hero/claudia-recorte.png';
import { destacados, foto, porColeccion, productos } from '../data/productos';
import { site, marcas, waLink } from '../data/site';

import mbDormitorio from '../../assets/moodboard/03-dormitorio.jpg';
import mbCocina from '../../assets/moodboard/04-cocina.jpg';
import mbExterior from '../../assets/moodboard/05-exterior.jpg';
import mbInteriorismo from '../../assets/moodboard/06-interiorismo-reformas.jpg';

const heroFondo = foto('claudia/claudia-01-drom');
const n = (c: Parameters<typeof porColeccion>[0]) => `${porColeccion(c).length} modelos`;
const colecciones = [
  { t: 'Sofás', h: '/sofas', img: foto('beatrice/beatrice-01'), ref: false, d: 'Rinconeras, chaise longue, relax y sofás cama', n: n('sofas') },
  { t: 'Salones', h: '/salones', img: foto('mauro/mauro-05-isco'), ref: false, d: 'Composiciones completas para la zona de estar', n: n('salones') },
  { t: 'Mobiliario', h: '/mobiliario', img: foto('sc002-costera-jun-023-mesa-pie-ovalado'), ref: false, d: 'Mesas, sillas, aparadores y butacas', n: n('mobiliario') },
  { t: 'Dormitorios', h: '/dormitorios', img: mbDormitorio, ref: true, d: 'Descanso, sofás cama y butacas', n: n('dormitorios') },
  { t: 'Cocinas', h: '/cocinas', img: mbCocina, ref: true, d: 'Distribuciones y materiales para el día a día', n: 'Consúltanos' },
  { t: 'Exterior', h: '/exterior', img: mbExterior, ref: true, d: 'Terrazas y jardines como parte de la casa', n: 'Consúltanos' },
];
const totalSofas = porColeccion('sofas').filter((p) => !p.tipos.includes('Pufs y auxiliares')).length;
const galeria = destacados.filter((p) => p.colecciones.includes('sofas')).slice(0, 8);
const nombreMarca = (slug: string) => marcas.find((m) => m.slug === slug)?.nombre ?? '';
const pasos = [
  ['Ven al showroom', 'Siéntate, compara modelos y toca los tejidos en San Sebastián de los Reyes.'],
  ['Elige medida y acabado', 'Te ayudamos con la composición, el tapizado y el color que encajan con tu salón.'],
  ['Lo preparamos', 'Gestionamos el pedido con el fabricante y te mantenemos informado.'],
  ['Lo disfrutas en casa', 'Coordinamos la entrega para que solo tengas que estrenarlo.'],
];
const marcasConFotos = marcas.filter((m) => productos.some((p) => p.marca === m.slug));
---
<Base
  overlay
  title="UNIK Sofás y Mobiliario · San Sebastián de los Reyes"
  description="Showroom de sofás, mobiliario e interiorismo en San Sebastián de los Reyes (Madrid). Descubre nuestras colecciones y ven a verlas en persona."
>
  <!-- 1. Hero: foto a sangre, wordmark gigante detrás del sofá recortado -->
  <section class="hero" aria-labelledby="hero-titulo">
    <div class="hero__media" aria-hidden="true">
      <Image src={heroFondo} alt="" width={1600} widths={[640, 1024, 1600, 2400]} sizes="100vw" class="hero__layer hero__bg" loading="eager" fetchpriority="high" />
    </div>
    <h1 id="hero-titulo" class="hero__marca">
      <span class="sr-only">UNIK Sofás, San Sebastián de los Reyes. Espacios para vivir. Diseño para sentir.</span>
      <span class="hero__logo" aria-hidden="true"><Logo /></span>
    </h1>
    <div class="hero__media hero__media--front" aria-hidden="true">
      <Image src={heroRecorte} alt="" width={1600} widths={[640, 1024, 1600, 2400]} sizes="100vw" class="hero__layer hero__cut" loading="eager" />
    </div>

    <div class="hero__pie">
      <p class="hero__claim" aria-hidden="true">
        <span class="ln"><span>Espacios para vivir.</span></span>
        <span class="ln"><span><em>Diseño para sentir.</em></span></span>
      </p>
      <a href="#intro" class="hero__scroll" aria-label="Seguir leyendo"><span></span></a>
      <div class="hero__dcha">
        <span class="ln"><a href="/visitanos" class="hero__cta" data-track="cta_reserva_visita" data-ubicacion="hero">Reserva tu visita <span aria-hidden="true">→</span></a></span>
        <span class="ln hero__credito"><span>Sofá Claudia · Bobbio</span></span>
      </div>
    </div>
  </section>

  <!-- 3. Intro: cita editorial descompensada + detalle vertical con parallax -->
  <section class="intro" id="intro" aria-labelledby="intro-titulo">
    <div class="intro__grid">
      <h2 id="intro-titulo" class="intro__kicker"><span>El diseño empieza</span> <em>en cada detalle</em></h2>
      <p class="intro__cita" data-lines>En UNIK creemos que un espacio bien pensado cambia la forma de vivirlo.</p>
      <div class="intro__cuerpo">
        <p>Seleccionamos mobiliario, sofás y propuestas para cada estancia, combinando estética, comodidad y funcionalidad. Desde una pieza especial hasta la transformación de un ambiente, queremos ayudarte a crear una casa que hable de ti.</p>
        <a href="/nosotros" class="intro__link">Conócenos <span aria-hidden="true">→</span></a>
      </div>
      <figure class="intro__foto">
        <div class="intro__marco">
          <Image src={foto('cotton/cotton-07')} alt="Mano ajustando la funda de lino de un sofá Cotton" width={1200} widths={[480, 800, 1200]} sizes="(max-width: 760px) 92vw, 34vw" class="intro__img" data-parallax="0.1" />
        </div>
        <figcaption>Funda desenfundable · Cotton, Bobbio</figcaption>
      </figure>
    </div>
  </section>

  <!-- 3. Colecciones: lista tipográfica; en escritorio la foto sigue al cursor -->
  <section class="cols" aria-labelledby="cols-titulo">
    <header class="cols__head">
      <h2 id="cols-titulo" class="kicker">Colecciones</h2>
      <p class="cols__nota">Seis maneras de empezar. <em class="cols__hover">Pasa por encima para verlas.</em></p>
    </header>
    <ListaTipografica items={colecciones} />
  </section>

  <!-- 4. Sofás: galería horizontal anclada al scroll (móvil: carrusel nativo) -->
  <section class="gal" aria-labelledby="gal-titulo" data-hscroll>
    <div class="gal__pista" data-hscroll-track>
      <div class="gal__intro">
        <h2 id="gal-titulo" class="gal__titulo">El sofá alrededor del que <em>sucede todo</em></h2>
        <p class="gal__texto">Una selección de los modelos que puedes probar en el showroom. Desliza para recorrerlos.</p>
        <a href="/sofas" class="gal__todos">Ver los {totalSofas} sofás <span aria-hidden="true">→</span></a>
      </div>
      {galeria.map((p, i) => (
        <a href={`/catalogo/${p.slug}`} class="gal__pieza">
          <div class="gal__img">
            <Image src={p.portada} alt={`Sofá ${p.nombre} de ${nombreMarca(p.marca)}`} width={1500} widths={[700, 1100, 1500]} sizes="(max-width: 900px) 86vw, 64vw" class="gal__foto" />
          </div>
          <div class="gal__pie">
            <span class="gal__idx">{String(i + 1).padStart(2, '0')} / {String(galeria.length).padStart(2, '0')}</span>
            <span class="gal__nombre">{p.nombre}</span>
            <span class="gal__datos">{nombreMarca(p.marca)} · {p.tipos.join(', ')}</span>
          </div>
        </a>
      ))}
      <a href="/sofas" class="gal__fin">
        <span class="gal__fin-num">{totalSofas}</span>
        <span>modelos para elegir con calma <em>Ver todos →</em></span>
      </a>
    </div>
  </section>

  <!-- 5. Cómo trabajamos: recorrido alternado -->
  <section class="pasos" aria-labelledby="pasos-titulo">
    <h2 id="pasos-titulo" class="kicker kicker--claro">Cómo trabajamos <em>De la idea a tu salón, sin complicaciones</em></h2>
    <ol class="pasos__lista">
      {pasos.map(([t, d], i) => (
        <li class:list={['pasos__paso', { 'pasos__paso--dcha': i % 2 === 1 }]}>
          <span class="pasos__n">{String(i + 1).padStart(2, '0')}</span>
          <p class="pasos__frase" data-lines>{t}</p>
          <p class="pasos__desc">{d}</p>
        </li>
      ))}
      <li class="pasos__apoyo" aria-hidden="true">
        <Image src={foto('zenit/zenit-02')} alt="" width={800} widths={[480, 800]} sizes="(max-width: 900px) 60vw, 26vw" class="pasos__img" data-parallax="0.12" />
      </li>
    </ol>
  </section>

  <!-- 6. Interiorismo y reformas: foto a sangre + caja que entra con el scroll -->
  <section class="inter" aria-labelledby="inter-titulo">
    <div class="inter__media">
      <Image src={mbInteriorismo} alt="Salón abierto con cocina y comedor integrados" width={1600} widths={[800, 1200, 1600]} sizes="100vw" class="inter__img" data-parallax="0.08" />
      <RefBadge />
    </div>
    <div class="inter__caja" data-reveal-box>
      <p class="kicker">Interiorismo y reformas</p>
      <h2 id="inter-titulo" class="inter__titulo">Espacios con sentido. <em>Espacios con identidad.</em></h2>
      <p>El interiorismo empieza escuchando: cómo vives, qué necesitas y qué quieres sentir en tu casa. A partir de ahí, mobiliario, materiales, distribución y luz trabajan juntos.</p>
      <div class="inter__links">
        <a href="/interiorismo">Interiorismo <span aria-hidden="true">→</span></a>
        <a href="/reformas">Reformas <span aria-hidden="true">→</span></a>
      </div>
    </div>
  </section>

  <!-- 7. Materiales: macro del tejido, texto mínimo -->
  <section class="mat" aria-labelledby="mat-titulo">
    <Image src={foto('beatrice/beatrice-08')} alt="Primer plano de un tejido de sofá con su etiqueta" width={1800} widths={[800, 1300, 1800]} sizes="100vw" class="mat__img" data-zoom />
    <div class="mat__txt">
      <h2 id="mat-titulo" class="mat__titulo" data-lines>Materiales que marcan la diferencia</h2>
      <p>Cada modelo admite distintos tejidos, colores y acabados. Ven a tocarlos.</p>
      <a href={waLink('Hola UNIK, quiero información sobre tejidos y acabados.')} target="_blank" rel="noopener" data-track="clic_whatsapp" data-ubicacion="home_materiales">Pregunta por WhatsApp <span aria-hidden="true">→</span></a>
    </div>
  </section>

  <!-- 8. Marcas: banda en movimiento -->
  <section class="marq" aria-labelledby="marq-titulo">
    <h2 id="marq-titulo" class="kicker">Marcas en el showroom</h2>
    <div class="marq__banda">
      {[0, 1].map((copia) => (
        <ul class="marq__fila" aria-hidden={copia === 1 ? 'true' : undefined}>
          {marcasConFotos.map((m) => (
            <li><a href={`/marcas/${m.slug}`} tabindex={copia === 1 ? -1 : undefined}>{m.nombre}</a><span class="marq__sep" aria-hidden="true">✳</span></li>
          ))}
        </ul>
      ))}
    </div>
  </section>

  <!-- 9. Visítanos -->
  <section class="vis" id="contacto" aria-labelledby="vis-titulo">
    <div class="vis__grid">
      <div class="vis__datos">
        <h2 id="vis-titulo" class="kicker">Visítanos</h2>
        <p class="vis__dir">
          <a href={site.mapsUrl} target="_blank" rel="noopener" data-track="clic_como_llegar" data-ubicacion="home">{site.direccion.calle}</a>
          <em>{site.direccion.ciudad}</em>
        </p>
        <dl class="vis__info">
          {site.horario.map((h) => <div><dt>{h.dias}</dt><dd>{h.horas}</dd></div>)}
          <div><dt>Teléfono</dt><dd><a href={site.telefonoHref} data-track="clic_telefono" data-ubicacion="home">{site.telefono}</a></dd></div>
        </dl>
        <div class="vis__links">
          <a href={site.mapsUrl} target="_blank" rel="noopener" data-track="clic_como_llegar" data-ubicacion="home">Cómo llegar <span aria-hidden="true">→</span></a>
          <a href={waLink('Hola UNIK, me gustaría reservar una visita al showroom.')} target="_blank" rel="noopener" data-track="clic_whatsapp" data-ubicacion="home_visitanos">Reservar por WhatsApp <span aria-hidden="true">→</span></a>
        </div>
      </div>
      <figure class="vis__foto">
        <Image src={foto('paula/paula-01-velvety')} alt="Sofá Paula de Bobbio en un salón luminoso" width={1000} widths={[600, 1000]} sizes="(max-width: 900px) 100vw, 40vw" class="vis__img" />
        <figcaption>Fotos del showroom, próximamente</figcaption>
      </figure>
      <div class="vis__form">
        <ContactForm titulo="Hablemos de tu próximo proyecto" />
      </div>
    </div>
  </section>
</Base>

<script>
  import '../scripts/motion';
</script>

<style>
  /* ---------- Hero ---------- */
  .hero { position: relative; height: 100vh; height: 100svh; min-height: 560px; overflow: hidden; background: #8f978d; isolation: isolate; }
  .hero__media { position: absolute; inset: 0; z-index: 0; }
  .hero__media--front { z-index: 2; pointer-events: none; }
  .hero :global(.hero__layer) { width: 100%; height: 100%; object-fit: cover; object-position: 50% 50%; animation: hero-zoom 2.6s var(--ease-out) both; }

  .hero__marca { position: absolute; z-index: 1; left: 0; right: 0; bottom: 33%; margin: 0; display: flex; justify-content: center; }
  .hero__logo { display: block; width: min(90vw, 150svh); color: var(--blanco-roto); animation: hero-wordmark 1.6s 0.25s var(--ease-out) both; }
  .hero__logo :global(svg) { display: block; width: 100%; height: auto; }

  .hero__pie {
    position: absolute; z-index: 3; left: 0; right: 0; bottom: 0;
    display: grid; grid-template-columns: 1fr auto 1fr; align-items: end; gap: 24px;
    padding: 0 calc(var(--gutter) + 72px) clamp(24px, 4vh, 44px) var(--gutter); color: var(--tinta);
  }
  .hero__claim { margin: 0; font-family: var(--font-display); font-weight: 340; font-size: clamp(1.3rem, 2.1vw, 2rem); line-height: 1.08; letter-spacing: -0.01em; }
  .hero__claim em { font-style: italic; }
  .hero__dcha { justify-self: end; text-align: right; display: grid; gap: 6px; }
  .hero__cta { display: inline-block; font-size: 0.78rem; letter-spacing: 0.16em; text-transform: uppercase; font-weight: 500; text-decoration: none; background: var(--blanco-roto); color: var(--tinta); padding: 12px 16px; transition: background 0.3s, color 0.3s; }
  .hero__cta:hover { background: var(--terracota); color: var(--blanco-roto); }
  .hero__credito { font-size: 0.72rem; letter-spacing: 0.08em; color: var(--tinta); }
  .hero__credito > span { background: var(--blanco-roto); padding: 3px 8px; }

  .hero__scroll { display: block; width: 1px; height: 56px; background: rgb(22 20 18 / 0.25); position: relative; overflow: hidden; }
  .hero__scroll span { position: absolute; left: 0; top: 0; width: 1px; height: 40%; background: var(--tinta); animation: hero-scroll 2.2s 1.8s var(--ease-out) infinite; }

  /* Texto por líneas */
  .hero .ln { display: block; overflow: hidden; }
  .hero .ln > * { display: inline-block; animation: hero-line 1.1s var(--ease-out) both; }
  .hero .ln:nth-child(1) > * { animation-delay: 0.9s; }
  .hero .ln:nth-child(2) > * { animation-delay: 1.02s; }
  .hero__dcha .ln:nth-child(1) > * { animation-delay: 1.15s; }
  .hero__dcha .ln:nth-child(2) > * { animation-delay: 1.25s; }

  @keyframes hero-zoom { from { transform: scale(1.1); } to { transform: none; } }
  @keyframes hero-wordmark { from { clip-path: inset(100% 0 0 0); transform: translateY(12%); } to { clip-path: inset(0 0 0 0); transform: none; } }
  @keyframes hero-line { from { transform: translateY(110%); } to { transform: none; } }
  @keyframes hero-scroll { 0% { transform: translateY(-100%); } 60%, 100% { transform: translateY(260%); } }

  /* Pantallas verticales (móvil y tablet): logo más arriba, claim sobre la pared */
  @media (max-width: 760px), (orientation: portrait) {
    .hero { height: 100svh; }
    .hero :global(.hero__layer) { object-position: 52% 50%; }
    .hero__marca { bottom: 43.5%; }
    .hero__logo { width: 92vw; }
    /* Deja sitio a la barra inferior fija */
    .hero__pie { position: static; display: block; padding: 0; }
    .hero__claim {
      position: absolute; z-index: 3; top: calc(72px + 5svh); right: var(--gutter); max-width: 80%;
      text-align: right; font-size: clamp(1.45rem, 6.6vw, 1.9rem);
    }
    .hero__scroll { display: none; }
    .hero__dcha { position: absolute; z-index: 3; right: var(--gutter); bottom: calc(68px + 2.5svh + env(safe-area-inset-bottom)); }
  }
  @media (min-width: 761px) and (orientation: portrait) {
    .hero__dcha { bottom: 4svh; right: calc(var(--gutter) + 72px); }
    .hero__claim { font-size: clamp(1.9rem, 4vw, 2.6rem); max-width: 60%; }
  }
  @media (prefers-reduced-motion: reduce) {
    .hero :global(.hero__layer), .hero__logo, .hero .ln > *, .hero__scroll span { animation: none; }
  }

  /* ---------- Intro ---------- */
  .intro { padding: clamp(96px, 14vw, 200px) 0 clamp(96px, 12vw, 180px); overflow: hidden; }
  .intro__grid {
    display: grid; grid-template-columns: repeat(12, 1fr); column-gap: clamp(16px, 2vw, 32px);
    padding: 0 var(--gutter); max-width: 1600px; margin: 0 auto; align-items: start;
  }
  .intro__kicker {
    grid-column: 1 / 5; grid-row: 1; margin: 0 0 clamp(32px, 5vw, 64px);
    font-family: var(--font-text); font-size: 0.8rem; font-weight: 500; letter-spacing: 0.04em; line-height: 1.4;
  }
  .intro__kicker em { font-family: var(--font-display); font-size: 1.15rem; font-weight: 340; letter-spacing: 0; color: var(--terracota); display: block; }
  .intro__cita {
    grid-column: 1 / 9; grid-row: 2; margin: 0;
    font-family: var(--font-display); font-weight: 320; font-size: clamp(2.2rem, 4.4vw, 4.4rem);
    line-height: 1.04; letter-spacing: -0.025em; text-wrap: balance;
  }
  .intro__cuerpo { grid-column: 5 / 9; grid-row: 3; margin-top: clamp(40px, 6vw, 96px); font-size: 1rem; line-height: 1.65; color: var(--ink-soft); max-width: 40ch; }
  .intro__link { display: inline-block; margin-top: 8px; color: var(--tinta); font-weight: 500; text-decoration: none; border-bottom: 1px solid var(--terracota); padding-bottom: 2px; }
  .intro__link:hover { color: var(--terracota); }
  .intro__foto { grid-column: 10 / 13; grid-row: 1 / 4; margin: clamp(-120px, -8vw, -40px) 0 0; }
  .intro__marco { aspect-ratio: 3 / 4.2; overflow: hidden; }
  .intro :global(.intro__img) { width: 100%; height: 120%; object-fit: cover; margin-top: -10%; }
  .intro figcaption { margin-top: 12px; font-size: 0.72rem; letter-spacing: 0.06em; color: var(--ink-soft); }

  @media (max-width: 900px) {
    .intro__kicker { grid-column: 1 / -1; }
    .intro__cita { grid-column: 1 / -1; font-size: clamp(2rem, 8.4vw, 2.8rem); }
    .intro__foto { grid-column: 3 / -1; grid-row: 3; margin: 48px 0 0; }
    .intro__cuerpo { grid-column: 1 / -1; grid-row: 4; margin-top: 40px; }
  }

  /* ---------- Piezas comunes ---------- */
  .kicker { font-family: var(--font-text); font-size: 0.8rem; font-weight: 500; letter-spacing: 0.04em; margin: 0; }
  .kicker em { display: block; font-family: var(--font-display); font-size: 1.15rem; font-weight: 340; letter-spacing: 0; color: var(--terracota); }
  .kicker--claro { color: var(--blanco-roto); }

  /* ---------- 3. Colecciones ---------- */
  .cols { padding: clamp(80px, 10vw, 160px) var(--gutter); max-width: 1600px; margin: 0 auto; position: relative; }
  .cols__head { display: flex; justify-content: space-between; align-items: flex-end; gap: 24px; margin-bottom: clamp(24px, 4vw, 48px); }
  .cols__nota { margin: 0; font-size: 0.85rem; color: var(--ink-soft); text-align: right; }
  .cols__nota em { font-family: var(--font-display); font-size: 1.05rem; }
  @media (hover: none), (pointer: coarse), (max-width: 760px) { .cols__hover { display: none; } }
  @media (max-width: 600px) { .cols__head { flex-direction: column; align-items: flex-start; } .cols__nota { text-align: left; } }

  /* ---------- 4. Galería de sofás ---------- */
  .gal { background: var(--arena); overflow: hidden; }
  .gal__pista {
    display: flex; gap: clamp(16px, 3vw, 56px); align-items: stretch;
    padding: clamp(64px, 8vw, 120px) var(--gutter);
    overflow-x: auto; scroll-snap-type: x mandatory; -webkit-overflow-scrolling: touch; scrollbar-width: none;
  }
  .gal__pista::-webkit-scrollbar { display: none; }
  .gal__intro { flex: 0 0 min(82vw, 440px); display: flex; flex-direction: column; justify-content: flex-end; scroll-snap-align: start; }
  .gal__titulo { font-weight: 320; font-size: clamp(2.4rem, 4.4vw, 4.6rem); letter-spacing: -0.03em; margin-bottom: 24px; }
  .gal__titulo em { color: var(--terracota); }
  .gal__texto { color: var(--ink-soft); max-width: 34ch; }
  .gal__todos, .gal__fin em { font-weight: 500; text-decoration: none; border-bottom: 1px solid var(--terracota); align-self: flex-start; padding-bottom: 2px; font-style: normal; }
  .gal__pieza { flex: 0 0 min(86vw, 64vw); text-decoration: none; scroll-snap-align: center; display: flex; flex-direction: column; }
  .gal__img { aspect-ratio: 16 / 10; overflow: hidden; background: var(--hueso); }
  .gal :global(.gal__foto) { width: 100%; height: 100%; object-fit: cover; transition: transform 1.2s var(--ease-out); }
  .gal__pieza:hover :global(.gal__foto) { transform: scale(1.03); }
  .gal__pie { display: grid; grid-template-columns: auto 1fr; align-items: baseline; column-gap: 24px; padding-top: 16px; }
  .gal__idx { font-size: 0.75rem; letter-spacing: 0.1em; color: var(--ink-soft); grid-row: span 2; align-self: start; padding-top: 1.2em; }
  .gal__nombre { font-family: var(--font-display); font-weight: 320; font-size: clamp(2.6rem, 6vw, 6.4rem); line-height: 0.95; letter-spacing: -0.035em; }
  .gal__datos { font-size: 0.85rem; color: var(--ink-soft); }
  .gal__fin { flex: 0 0 min(70vw, 360px); display: flex; flex-direction: column; justify-content: center; gap: 12px; text-decoration: none; scroll-snap-align: end; }
