---
import ColeccionPage from '../components/ColeccionPage.astro';
import hero from '../../assets/moodboard/06-interiorismo-reformas.jpg';
---
<ColeccionPage
  seoTitle="Interiorismo en San Sebastián de los Reyes · UNIK"
  seoDescription="Interiorismo y asesoramiento en San Sebastián de los Reyes: mobiliario, materiales, distribución y luz para crear un ambiente personal."
  eyebrow="Interiorismo"
  titulo="Espacios con sentido. Espacios con identidad."
  texto="El interiorismo empieza escuchando: cómo vives, qué necesitas y qué quieres sentir en tu casa. A partir de ahí, el mobiliario, los materiales, la distribución y la luz pueden trabajar juntos para crear un ambiente personal y duradero. En UNIK queremos acompañarte en ese proceso con una mirada cuidada y práctica."
  hero={hero}
  heroRef
  pendiente="Confirmar alcance del servicio (asesoramiento en tienda, proyecto completo, visitas a domicilio) y proyectos reales."
  bloquesTitulo="Nuestro proceso"
  bloques={[
    { t: 'Te escuchamos', d: 'Una primera conversación en el showroom sobre tu casa, tu forma de vivir y lo que quieres cambiar.' },
    { t: 'Proponemos', d: 'Mobiliario, tejidos, materiales y distribución pensados para tu espacio.' },
    { t: 'Lo hacemos realidad', d: 'Coordinamos piezas y acabados para que el resultado sea coherente.' },
  ]}
  ctaPrincipal="Hablemos de tu espacio"
  tipoConsulta="Interiorismo"
/>
