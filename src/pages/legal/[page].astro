---
import Base from '../../layouts/Base.astro';
import { legal } from '../../data/legal';
import { site } from '../../data/site';

export function getStaticPaths() {
  return (Object.keys(legal) as (keyof typeof legal)[]).map((page) => ({ params: { page }, props: { texto: legal[page] } }));
}
const { texto } = Astro.props;
---
<Base title={`${texto.titulo} · UNIK`} description={`${texto.titulo} de ${site.razonSocial}.`}>
  <article class="lg">
    <header class="lg__head">
      <p class="lg__kicker">Legal <em>Actualizado: <span set:html={texto.actualizado} /></em></p>
      <h1 class="lg__titulo">{texto.titulo}</h1>
      {site.pendiente && <p class="lg__aviso">Borrador pendiente de completar y de revisión por un asesor legal. Los datos marcados en amarillo faltan.</p>}
      <p class="lg__intro">{texto.intro}</p>
    </header>
    <div class="lg__cuerpo">
      {texto.secciones.map((s) => (
        <section>
          <h2>{s.h}</h2>
          {s.p.map((p) => (p.trim().startsWith('<table') ? <div class="lg__tabla" set:html={p} /> : <p set:html={p} />))}
        </section>
      ))}
    </div>
    <nav class="lg__nav" aria-label="Otros textos legales">
      <a href="/legal/aviso-legal">Aviso legal</a>
      <a href="/legal/privacidad">Privacidad</a>
      <a href="/legal/cookies">Cookies</a>
    </nav>
  </article>
</Base>

<style>
  .lg { padding: clamp(40px, 6vw, 96px) var(--gutter) clamp(80px, 10vw, 160px); max-width: 1600px; margin: 0 auto; display: grid; grid-template-columns: repeat(12, 1fr); column-gap: 24px; }
  .lg__head { grid-column: 1 / -1; }
  .lg__kicker { display: flex; justify-content: space-between; font-size: 0.8rem; font-weight: 500; margin: 0 0 24px; }
  .lg__kicker em { font-family: var(--font-display); font-size: 1rem; font-weight: 340; color: var(--ink-soft); }
  .lg__titulo { font-weight: 300; font-size: clamp(3rem, 8vw, 8rem); line-height: 0.92; letter-spacing: -0.045em; }
  .lg__aviso { display: inline-block; font-size: 0.85rem; color: var(--terracota); border-left: 2px solid var(--terracota); padding-left: 12px; }
  .lg__intro { font-family: var(--font-display); font-weight: 320; font-size: clamp(1.3rem, 2vw, 1.9rem); line-height: 1.25; letter-spacing: -0.015em; max-width: 40ch; margin: 24px 0 clamp(40px, 6vw, 96px); }
  .lg__cuerpo { grid-column: 4 / 11; }
  .lg__cuerpo section { padding: 28px 0; border-top: 1px solid var(--line); }
  .lg__cuerpo h2 { font-weight: 340; font-size: clamp(1.5rem, 2.2vw, 2rem); letter-spacing: -0.02em; margin-bottom: 14px; }
  .lg__cuerpo p { color: var(--ink-soft); max-width: 70ch; }
  .lg__cuerpo :global(strong) { color: var(--tinta); font-weight: 500; }
  .lg__cuerpo :global(mark) { background: #f3e2a6; color: var(--tinta); padding: 0 4px; }
  .lg__tabla { overflow-x: auto; margin: 8px 0 16px; }
  .lg__tabla :global(table) { border-collapse: collapse; width: 100%; font-size: 0.88rem; min-width: 560px; }
  .lg__tabla :global(th), .lg__tabla :global(td) { text-align: left; vertical-align: top; padding: 10px 12px 10px 0; border-bottom: 1px solid var(--line); }
  .lg__tabla :global(th) { font-size: 0.72rem; letter-spacing: 0.1em; text-transform: uppercase; color: var(--ink-soft); font-weight: 500; }
  .lg__nav { grid-column: 4 / 11; display: flex; gap: 28px; padding-top: 28px; border-top: 1px solid var(--line); }
  .lg__nav a { font-weight: 500; text-decoration: none; border-bottom: 1px solid var(--terracota); padding-bottom: 2px; }
  @media (max-width: 900px) { .lg__cuerpo, .lg__nav { grid-column: 1 / -1; } }
</style>
