---
import Base from '../../layouts/Base.astro';
export function getStaticPaths() {
  return [
    { params: { page: 'aviso-legal' }, props: { t: 'Aviso legal' } },
    { params: { page: 'privacidad' }, props: { t: 'Política de privacidad' } },
    { params: { page: 'cookies' }, props: { t: 'Política de cookies' } },
  ];
}
const { t } = Astro.props;
---
<Base title={`${t} · UNIK`} description={t}>
  <section class="section"><div class="wrap" style="max-width:820px">
    <h1>{t}</h1>
    <p class="lead">Texto pendiente. Debe redactarse con asesoramiento legal (RGPD / LSSI) con los datos de UNIK Interior Design SL.</p>
  </div></section>
</Base>
