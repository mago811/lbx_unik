---
import Base from '../../layouts/Base.astro';
import ListaTipografica from '../../components/ListaTipografica.astro';
import { marcas } from '../../data/site';
import { porMarca } from '../../data/productos';

const conFotos = marcas.filter((m) => porMarca(m.slug).length);
const sinFotos = marcas.filter((m) => !porMarca(m.slug).length);
const items = conFotos.map((m) => {
  const ps = porMarca(m.slug);
  return { t: m.nombre, h: `/marcas/${m.slug}`, img: (ps.find((p) => p.destacado) ?? ps[0]).portada, d: m.foco, n: `${ps.length} ${ps.length === 1 ? 'referencia' : 'referencias'}` };
});
---
<Base title="Marcas de sofás y mobiliario · UNIK San Sebastián de los Reyes" description="Bobbio, Pedro Ortiz, Afosxsofas, Rodri Diseño, Oslo y Modesto Navarro: las marcas de sofás y mobiliario que puedes ver en el showroom de UNIK en San Sebastián de los Reyes.">
  <section class="mk">
    <p class="mk__kicker">Marcas <em>{conFotos.length} fabricantes en el showroom</em></p>
    <h1 class="mk__titulo" data-lines>Fabricantes en los que confiamos.</h1>
    <p class="mk__texto">Trabajamos con fabricantes que comparten nuestra forma de entender el diseño: piezas bien hechas, cómodas y pensadas para durar.</p>
    <ListaTipografica items={items} />
    {sinFotos.length > 0 && <p class="mk__nota">También trabajamos con {sinFotos.map((m) => m.nombre).join(', ')}. Pregúntanos por sus colecciones.</p>}
  </section>
</Base>

<style>
  .mk { padding: clamp(40px, 6vw, 96px) var(--gutter) clamp(80px, 10vw, 160px); max-width: 1600px; margin: 0 auto; }
  .mk__kicker { display: flex; justify-content: space-between; font-size: 0.8rem; font-weight: 500; margin: 0 0 24px; }
  .mk__kicker em { font-family: var(--font-display); font-size: 1.05rem; font-weight: 340; color: var(--terracota); }
  .mk__titulo { font-weight: 300; font-size: clamp(3rem, 8.4vw, 8.6rem); line-height: 0.92; letter-spacing: -0.045em; max-width: 13ch; }
  .mk__texto { max-width: 44ch; color: var(--ink-soft); margin: 0 0 clamp(48px, 6vw, 96px) auto; }
  .mk__nota { margin-top: 32px; color: var(--ink-soft); font-size: 0.9rem; }
</style>
