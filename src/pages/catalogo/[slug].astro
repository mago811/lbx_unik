---
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import ProductCard from '../../components/ProductCard.astro';
import ContactForm from '../../components/ContactForm.astro';
import { productos, type Producto } from '../../data/productos';
import { marcas, waLink, site } from '../../data/site';

export function getStaticPaths() {
  return productos.map((p) => ({ params: { slug: p.slug }, props: { p } }));
}
const { p } = Astro.props as { p: Producto };
const marca = marcas.find((m) => m.slug === p.marca)!;
const relacionados = productos.filter((x) => x.slug !== p.slug && x.tipos.some((t) => p.tipos.includes(t))).slice(0, 3);
const ref = `${p.nombre} (${marca.nombre})`;
const coleccion = p.colecciones[0];
const NOMBRES = { sofas: 'Sofás', mobiliario: 'Mobiliario', salones: 'Salones', dormitorios: 'Dormitorios' } as const;
const tapizado = p.colecciones.includes('sofas') || p.tipos.includes('Silla');
const tipoConsulta = p.colecciones.includes('sofas') ? 'Sofás' : 'Mobiliario';
---
<Base
  title={`${p.nombre} de ${marca.nombre} · ${p.tipos[0]} · UNIK San Sebastián de los Reyes`}
  description={`${p.resumen} Ven a verlo al showroom de UNIK en San Sebastián de los Reyes o consúltanos por WhatsApp.`}
  waTexto={`Hola UNIK, me interesa el modelo ${ref}.`}
>
  <article class="fp">
    <header class="fp__head">
      <nav class="fp__crumbs" aria-label="Migas de pan"><a href="/">Inicio</a> / <a href={`/${coleccion}`}>{NOMBRES[coleccion]}</a> / {p.nombre}</nav>
      <h1 class="fp__nombre" data-lines>{p.nombre}</h1>
      <p class="fp__sub"><a href={`/marcas/${marca.slug}`}>{marca.nombre}</a><span>{p.tipos.join(' · ')}</span></p>
    </header>

    <div class="fp__grid">
      <div class="fp__gal">
        <div class="fp__main">
          <Image src={p.fotos[0]} alt={`${p.nombre} de ${marca.nombre}`} width={1100} widths={[640, 1100]} sizes="(max-width: 900px) 100vw, 66vw" quality={75} class="fp__img" loading="eager" fetchpriority="high" id="gal-main" />
        </div>
        {p.fotos.length > 1 && (
          <div class="fp__thumbs">
            {p.fotos.slice(0, 12).map((f, i) => (
              <button class:list={['gal__t', { on: i === 0 }]} aria-label={`Ver foto ${i + 1} de ${p.fotos.length}`} aria-pressed={i === 0 ? 'true' : 'false'}>
                <Image src={f} alt="" width={240} widths={[240, 1100]} sizes="120px" quality={75} class="fp__thumb" />
              </button>
            ))}
          </div>
        )}
      </div>

      <aside class="fp__info">
        <p class="fp__resumen">{p.resumen}</p>
        <dl>
          <div><dt>Medidas</dt><dd>Varias composiciones. Consúltanos.</dd></div>
          {tapizado
            ? <div><dt>Tapizados</dt><dd>Amplio muestrario de tejidos y colores en tienda.</dd></div>
            : <div><dt>Acabados</dt><dd>Varios materiales y acabados. Consúltanos.</dd></div>}
          <div><dt>Dónde verlo</dt><dd>Showroom UNIK · {site.direccion.ciudad}</dd></div>
        </dl>
        <div class="fp__ctas">
          <a href={waLink(`Hola UNIK, me interesa el modelo ${ref}. ¿Me dais más información?`)} class="btn btn--wa" target="_blank" rel="noopener" data-track="clic_whatsapp" data-ubicacion={`ficha_${p.slug}`}>Consultar por WhatsApp</a>
          <a href="#consulta" class="fp__link" data-track="cta_consulta" data-ubicacion={`ficha_${p.slug}`}>Pedir información por email <span aria-hidden="true">→</span></a>
          <a href="/visitanos" class="fp__link" data-track="cta_reserva_visita" data-ubicacion={`ficha_${p.slug}`}>Verlo en el showroom <span aria-hidden="true">→</span></a>
        </div>
        <p class="fp__nota">Ficha provisional. Medidas, acabados y ficha técnica pendientes del proveedor.</p>
      </aside>
    </div>
  </article>

  {relacionados.length > 0 && (
    <section class="rel">
      <h2 class="rel__titulo">También te puede <em>gustar</em></h2>
      <div class="rel__grid">{relacionados.map((x) => <ProductCard p={x} />)}</div>
    </section>
  )}

  <section class="cons" id="consulta">
    <div class="cons__grid">
      <h2 class="cons__titulo">Consultar <em>{p.nombre}</em></h2>
      <ContactForm referencia={ref} tipo={tipoConsulta} titulo="Te respondemos con medidas, tejidos y disponibilidad" />
    </div>
  </section>
</Base>

<script>
  import '../../scripts/motion';
  const main = document.getElementById('gal-main') as HTMLImageElement | null;
  document.querySelectorAll<HTMLButtonElement>('.gal__t').forEach((b) =>
    b.addEventListener('click', () => {
      const img = b.querySelector('img')!;
      // la miniatura incluye la versión grande en su srcset
      const big = img.srcset.split(',').map((s) => s.trim().split(' ')).sort((a, c) => parseInt(c[1]) - parseInt(a[1]))[0][0];
      if (main) { main.srcset = ''; main.src = big; }
      document.querySelectorAll('.gal__t').forEach((x) => {
        x.classList.toggle('on', x === b);
        x.setAttribute('aria-pressed', String(x === b));
      });
    }),
  );
</script>

<style>
  .fp { padding: clamp(24px, 4vw, 56px) var(--gutter) clamp(80px, 9vw, 140px); max-width: 1600px; margin: 0 auto; }
  .fp__crumbs { font-size: 0.8rem; color: var(--ink-soft); margin-bottom: clamp(16px, 3vw, 40px); }
  .fp__crumbs a { text-decoration: none; }
  .fp__nombre { font-weight: 300; font-size: clamp(4rem, 13vw, 13rem); line-height: 0.85; letter-spacing: -0.05em; margin: 0; }
  .fp__sub { display: flex; gap: 20px; flex-wrap: wrap; align-items: baseline; margin: 16px 0 clamp(32px, 4vw, 56px); font-size: 0.95rem; color: var(--ink-soft); }
  .fp__sub a { color: var(--terracota); font-family: var(--font-display); font-size: 1.3rem; font-style: italic; text-decoration: none; }
  .fp__grid { display: grid; grid-template-columns: repeat(12, 1fr); column-gap: 24px; row-gap: 40px; }
  .fp__gal { grid-column: 1 / 9; }
  .fp__main { aspect-ratio: 4 / 3; overflow: hidden; background: var(--blanco-roto); }
  .fp :global(.fp__img) { width: 100%; height: 100%; object-fit: cover; }
  .fp__thumbs { display: flex; gap: 8px; margin-top: 8px; overflow-x: auto; scrollbar-width: thin; }
  .gal__t { flex: 0 0 96px; padding: 0; border: 0; outline: 1px solid transparent; outline-offset: -1px; background: var(--blanco-roto); aspect-ratio: 1; overflow: hidden; cursor: pointer; opacity: 0.55; transition: opacity 0.25s; }
  .gal__t:hover, .gal__t.on { opacity: 1; }
  .gal__t.on { outline-color: var(--tinta); }
  .fp :global(.fp__thumb) { width: 100%; height: 100%; object-fit: cover; }
  .fp__info { grid-column: 9 / 13; position: sticky; top: 110px; align-self: start; }
  .fp__resumen { font-family: var(--font-display); font-weight: 320; font-size: clamp(1.4rem, 1.9vw, 1.9rem); line-height: 1.2; letter-spacing: -0.015em; margin: 0 0 28px; }
  dl { margin: 0 0 28px; border-top: 1px solid var(--line); }
  dl > div { display: grid; grid-template-columns: 7.5rem 1fr; gap: 12px; padding: 12px 0; border-bottom: 1px solid var(--line); font-size: 0.92rem; }
  dt { font-size: 0.72rem; letter-spacing: 0.1em; text-transform: uppercase; color: var(--ink-soft); padding-top: 3px; }
  dd { margin: 0; }
  .fp__ctas { display: grid; gap: 14px; justify-items: start; }
  .fp__ctas .btn { width: 100%; }
  .fp__link { font-weight: 500; text-decoration: none; border-bottom: 1px solid var(--terracota); padding-bottom: 2px; }
  .fp__link:hover { color: var(--terracota); }
  .fp__nota { font-size: 0.78rem; color: var(--terracota); margin-top: 24px; }
  @media (max-width: 900px) { .fp__gal, .fp__info { grid-column: 1 / -1; } .fp__info { position: static; } }

  .rel { padding: clamp(80px, 9vw, 140px) var(--gutter); border-top: 1px solid var(--line); max-width: 1600px; margin: 0 auto; }
  .rel__titulo { font-weight: 300; font-size: clamp(2.4rem, 5vw, 5rem); letter-spacing: -0.035em; margin-bottom: clamp(32px, 4vw, 56px); }
  .rel__titulo em { color: var(--terracota); }
  .rel__grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: clamp(16px, 2vw, 32px); }
  @media (max-width: 900px) { .rel__grid { grid-template-columns: 1fr; } }

  .cons { padding: clamp(80px, 9vw, 140px) var(--gutter); background: var(--arena); }
  .cons__grid { display: grid; grid-template-columns: 1fr 1.2fr; gap: clamp(40px, 6vw, 112px); max-width: 1600px; margin: 0 auto; align-items: start; }
  .cons__titulo { font-weight: 300; font-size: clamp(2.8rem, 6vw, 6rem); line-height: 0.95; letter-spacing: -0.04em; }
  .cons__titulo em { display: block; color: var(--terracota); }
  @media (max-width: 900px) { .cons__grid { grid-template-columns: 1fr; } }
</style>
