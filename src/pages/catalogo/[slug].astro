---
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import ProductCard from '../../components/ProductCard.astro';
import ContactForm from '../../components/ContactForm.astro';
import { productos, type Producto } from '../../data/productos';
import { marcas, waLink, site } from '../../data/site';

export function getStaticPaths() {
  return productos.map((p) => ({ params: { slug: p.slug }, props: { p } }));
}
const { p } = Astro.props as { p: Producto };
const marca = marcas.find((m) => m.slug === p.marca)!;
const relacionados = productos.filter((x) => x.slug !== p.slug && x.tipos.some((t) => p.tipos.includes(t))).slice(0, 3);
const ref = `${p.nombre} (${marca.nombre})`;
const coleccion = p.colecciones[0];
const tapizado = p.colecciones.includes('sofas') || p.tipos.includes('Silla');
const tipoConsulta = p.colecciones.includes('sofas') ? 'Sofás' : 'Mobiliario';
---
<Base
  title={`${p.nombre} de ${marca.nombre} · ${p.tipos[0]} · UNIK San Sebastián de los Reyes`}
  description={`${p.resumen} Ven a verlo al showroom de UNIK en San Sebastián de los Reyes o consúltanos por WhatsApp.`}
  waTexto={`Hola UNIK, me interesa el modelo ${ref}.`}
>
  <div class="wrap crumbs"><a href="/">Inicio</a> / <a href={`/${coleccion}`}>{coleccion[0].toUpperCase() + coleccion.slice(1)}</a> / {p.nombre}</div>
  <section class="wrap ficha">
    <div class="gal">
      <div class="gal__main">
        <Image src={p.fotos[0]} alt={`${p.nombre} de ${marca.nombre}`} width={1100} widths={[640, 1100]} sizes="(max-width: 900px) 100vw, 60vw" quality={75} class="cover" loading="eager" id="gal-main" />
      </div>
      {p.fotos.length > 1 && (
        <div class="gal__thumbs">
          {p.fotos.slice(0, 12).map((f, i) => (
            <button class:list={['gal__t', { on: i === 0 }]} aria-label={`Ver foto ${i + 1}`}>
              <Image src={f} alt="" width={240} widths={[240, 1100]} sizes="120px" quality={75} class="cover" />
            </button>
          ))}
        </div>
      )}
    </div>
    <div class="info">
      <a href={`/marcas/${marca.slug}`} class="eyebrow">{marca.nombre}</a>
      <h1>{p.nombre}</h1>
      <p class="info__tipos">{p.tipos.join(' · ')}</p>
      <p class="lead">{p.resumen}</p>
      <dl>
        <dt>Medidas</dt><dd>Varias composiciones. Consúltanos.</dd>
        {tapizado
          ? <><dt>Tapizados</dt><dd>Amplio muestrario de tejidos y colores en tienda.</dd></>
          : <><dt>Acabados</dt><dd>Varios materiales y acabados. Consúltanos.</dd></>}
        <dt>Dónde verlo</dt><dd>Showroom UNIK · {site.direccion.ciudad}</dd>
      </dl>
      <div class="btns info__btns">
        <a href={waLink(`Hola UNIK, me interesa el modelo ${ref}. ¿Me dais más información?`)} class="btn btn--wa" target="_blank" rel="noopener" data-track="clic_whatsapp" data-ubicacion={`ficha_${p.slug}`}>WhatsApp</a>
        <a href="#consulta" class="btn btn--ghost" data-track="cta_consulta" data-ubicacion={`ficha_${p.slug}`}>Pedir información</a>
      </div>
      <p class="info__nota">Ficha provisional. Medidas, acabados y ficha técnica pendientes del proveedor.</p>
    </div>
  </section>

  {relacionados.length > 0 && (
    <section class="section">
      <div class="wrap">
        <h2>También te puede gustar</h2>
        <div class="grid grid-3" style="margin-top:32px">{relacionados.map((x) => <ProductCard p={x} />)}</div>
      </div>
    </section>
  )}

  <section class="section section--arena" id="consulta">
    <div class="wrap" style="max-width:820px">
      <ContactForm referencia={ref} tipo={tipoConsulta} titulo={`Consultar ${p.nombre}`} />
    </div>
  </section>
</Base>

<script>
  const main = document.getElementById('gal-main') as HTMLImageElement | null;
  document.querySelectorAll<HTMLButtonElement>('.gal__t').forEach((b) =>
    b.addEventListener('click', () => {
      const img = b.querySelector('img')!;
      // la miniatura incluye la versión grande en su srcset
      const big = img.srcset.split(',').map((s) => s.trim().split(' ')).sort((a, c) => parseInt(c[1]) - parseInt(a[1]))[0][0];
      if (main) { main.srcset = ''; main.src = big; }
      document.querySelectorAll('.gal__t').forEach((x) => x.classList.toggle('on', x === b));
    }),
  );
</script>

<style>
  .crumbs { font-size: 0.82rem; color: var(--ink-soft); padding-block: 20px; }
  .crumbs a { text-decoration: none; }
  .ficha { display: grid; grid-template-columns: 1.5fr 1fr; gap: clamp(32px, 5vw, 72px); padding-bottom: clamp(56px, 7vw, 96px); }
  .gal__main { aspect-ratio: 4 / 3; overflow: hidden; background: var(--surface); }
  .gal__thumbs { display: grid; grid-template-columns: repeat(6, 1fr); gap: 8px; margin-top: 8px; }
  .gal__t { padding: 0; border: 2px solid transparent; background: var(--surface); aspect-ratio: 1; overflow: hidden; cursor: pointer; }
  .gal__t.on { border-color: var(--azul-noche); }
  .info { position: sticky; top: 110px; align-self: start; }
  .info .eyebrow { text-decoration: none; }
  .info__tipos { color: var(--ink-soft); margin-top: -8px; }
  dl { display: grid; grid-template-columns: auto 1fr; gap: 10px 24px; margin: 28px 0; padding: 20px 0; border-block: 1px solid var(--line); font-size: 0.95rem; }
  dt { font-size: 0.72rem; letter-spacing: 0.16em; text-transform: uppercase; color: var(--nogal); padding-top: 3px; }
  dd { margin: 0; }
  .info__btns .btn { flex: 1 1 220px; }
  .info__nota { font-size: 0.8rem; color: var(--nogal); margin-top: 16px; }
  @media (max-width: 900px) { .ficha { grid-template-columns: 1fr; } .info { position: static; } .gal__thumbs { grid-template-columns: repeat(4, 1fr); } }
</style>
