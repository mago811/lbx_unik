---
import ColeccionPage from '../components/ColeccionPage.astro';
import { porColeccion } from '../data/productos';
import hero from '../../assets/moodboard/02-comedor-mobiliario.jpg';
---
<ColeccionPage
  seoTitle="Mobiliario y muebles en San Sebastián de los Reyes · UNIK"
  seoDescription="Mesas, sillas, aparadores, butacas y muebles auxiliares. Tienda de muebles en San Sebastián de los Reyes (Madrid)."
  eyebrow="Mobiliario"
  titulo="Piezas que definen un espacio."
  texto="La personalidad de una casa se construye con piezas bien elegidas. Mesas, sillas, muebles auxiliares y soluciones de almacenaje que aportan equilibrio, calidez y sentido a cada estancia. Descubre referencias que conviven con naturalidad y hacen que cada rincón tenga su propia identidad."
  hero={hero}
  heroRef
  productos={porColeccion('mobiliario')}
  pendiente="Faltan las fotos de mesas, sillas y aparadores (Rodri Diseño, Modesto Navarro, Oslo). De momento se muestran butacas y auxiliares."
  ctaPrincipal="Consultar una pieza"
  tipoConsulta="Mobiliario"
/>
