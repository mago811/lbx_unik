---
import ColeccionPage from '../components/ColeccionPage.astro';
import hero from '../../assets/moodboard/06-interiorismo-reformas.jpg';
---
<ColeccionPage
  seoTitle="Reformas en San Sebastián de los Reyes · UNIK"
  seoDescription="Reformas en San Sebastián de los Reyes: mejora recorridos, aprovecha la luz y crea ambientes más cómodos. Cuéntanos tu proyecto."
  eyebrow="Reformas"
  titulo="Nuevas posibilidades para cada espacio."
  texto="A veces no hace falta cambiar de lugar, sino descubrir una forma distinta de vivirlo. Una reforma bien planteada permite mejorar recorridos, aprovechar la luz y crear ambientes más cómodos y coherentes. Cuéntanos qué te gustaría transformar y estudiemos juntos las posibilidades de tu espacio."
  hero={hero}
  heroRef
  pendiente="Confirmar qué reformas hace UNIK (integrales, parciales, con colaboradores) y conseguir fotos reales antes/después."
  bloquesTitulo="Cómo trabajamos"
  bloques={[
    { t: 'Nos cuentas tu idea', d: 'Fotos, medidas y lo que te gustaría cambiar. Puedes empezar por WhatsApp.' },
    { t: 'Estudiamos el espacio', d: 'Valoramos las posibilidades y te proponemos una solución.' },
    { t: 'Presupuesto claro', d: 'Te explicamos el alcance antes de empezar.' },
  ]}
  ctaPrincipal="Contar mi proyecto"
  tipoConsulta="Reformas"
/>
