---
// Plantilla común para colecciones (Sofás, Mobiliario, Salones…) y servicios.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Base from '../layouts/Base.astro';
import ProductCard from './ProductCard.astro';
import ContactForm from './ContactForm.astro';
import RefBadge from './RefBadge.astro';
import { tiposDe, type Producto } from '../data/productos';
import { waLink } from '../data/site';

interface Props {
  seoTitle: string;
  seoDescription: string;
  eyebrow: string;
  titulo: string;
  texto: string;
  hero: ImageMetadata;
  heroRef?: boolean;
  productos?: Producto[];
  /** Estado del contenido: si falta confirmar el servicio con UNIK */
  pendiente?: string;
  bloques?: { t: string; d: string }[];
  bloquesTitulo?: string;
  ctaPrincipal: string;
  tipoConsulta: string;
}
const p = Astro.props;
const lista = p.productos ?? [];
const tipos = tiposDe(lista);
---
<Base title={p.seoTitle} description={p.seoDescription} waTexto={`Hola UNIK, quiero información sobre ${p.eyebrow.toLowerCase()}.`}>
  <section class="ph">
    <div class="wrap ph__grid">
      <div class="ph__txt">
        <span class="eyebrow">{p.eyebrow}</span>
        <h1>{p.titulo}</h1>
        <p class="lead">{p.texto}</p>
        <div class="btns">
          <a href="#consulta" class="btn" data-track="cta_consulta" data-ubicacion={p.eyebrow}>{p.ctaPrincipal}</a>
          <a href={waLink(`Hola UNIK, quiero información sobre ${p.eyebrow.toLowerCase()}.`)} class="btn btn--wa" target="_blank" rel="noopener" data-track="clic_whatsapp" data-ubicacion={p.eyebrow}>WhatsApp</a>
        </div>
        {p.pendiente && <p class="ph__pend">⚠ {p.pendiente}</p>}
      </div>
      <div class="ph__img">
        <Image src={p.hero} alt={p.titulo} widths={[600, 1000, 1400]} sizes="(max-width: 900px) 100vw, 55vw" class="cover" loading="eager" />
        {p.heroRef && <RefBadge />}
      </div>
    </div>
  </section>

  {lista.length > 0 && (
    <section class="section section--surface">
      <div class="wrap">
        <div class="cat__head">
          <h2>{lista.length} modelos</h2>
          {tipos.length > 1 && (
            <div class="filtros" role="group" aria-label="Filtrar por tipo">
              <button class="on" data-f="">Todos</button>
              {tipos.map((t) => <button data-f={t}>{t}</button>)}
            </div>
          )}
        </div>
        <div class="grid grid-3 cat__grid">
          {lista.map((x) => <ProductCard p={x} />)}
        </div>
      </div>
    </section>
  )}

  {p.bloques && (
    <section class="section">
      <div class="wrap">
        {p.bloquesTitulo && <h2 class="reveal" style="max-width:20ch">{p.bloquesTitulo}</h2>}
        <div class="grid grid-3 bloques">
          {p.bloques.map((b, i) => (
            <div class="reveal"><span class="bloques__n">{String(i + 1).padStart(2, '0')}</span><h3>{b.t}</h3><p>{b.d}</p></div>
          ))}
        </div>
      </div>
    </section>
  )}

  <section class="section section--arena" id="consulta">
    <div class="wrap consulta">
      <div>
        <span class="eyebrow">Te asesoramos</span>
        <h2>¿Lo vemos juntos?</h2>
        <p class="lead">Cuéntanos qué buscas, comparte medidas o fotos de tu espacio y te proponemos opciones. O ven directamente al showroom.</p>
      </div>
      <ContactForm tipo={p.tipoConsulta} titulo={p.ctaPrincipal} />
    </div>
  </section>
</Base>

<script>
  document.querySelectorAll<HTMLButtonElement>('.filtros button').forEach((b) =>
    b.addEventListener('click', () => {
      const f = b.dataset.f!;
      document.querySelectorAll('.filtros button').forEach((x) => x.classList.toggle('on', x === b));
      document.querySelectorAll<HTMLElement>('.cat__grid .pc').forEach((card) => {
        card.hidden = !!f && !card.dataset.tipos!.split('|').includes(f);
      });
    }),
  );
</script>

<style>
  .ph { padding: clamp(32px, 5vw, 64px) 0 clamp(56px, 7vw, 96px); }
  .ph__grid { display: grid; grid-template-columns: 1fr 1.2fr; gap: clamp(32px, 5vw, 80px); align-items: center; }
  .ph__img { position: relative; aspect-ratio: 5 / 4; overflow: hidden; }
  .ph__pend { margin-top: 20px; font-size: 0.85rem; color: var(--nogal); background: var(--arena); padding: 10px 14px; }
  @media (max-width: 900px) { .ph__grid { grid-template-columns: 1fr; } .ph__img { order: -1; } }

  .cat__head { display: flex; justify-content: space-between; align-items: flex-end; gap: 24px; flex-wrap: wrap; margin-bottom: 32px; }
  .cat__head h2 { margin: 0; font-size: clamp(1.5rem, 2.4vw, 2rem); }
  .filtros { display: flex; flex-wrap: wrap; gap: 8px; }
  .filtros button {
    font: 500 0.75rem var(--font-text); letter-spacing: 0.1em; text-transform: uppercase;
    padding: 9px 14px; border: 1px solid var(--line); background: transparent; color: var(--ink); cursor: pointer; border-radius: 999px;
  }
  .filtros button.on, .filtros button:hover { background: var(--azul-noche); color: var(--marfil); border-color: var(--azul-noche); }
  .cat__grid :global(.pc[hidden]) { display: none; }

  .bloques { margin-top: 40px; }
  .bloques > div { border-top: 1px solid var(--line); padding-top: 20px; }
  .bloques__n { font-family: var(--font-display); font-weight: 900; font-size: 1.8rem; color: var(--piedra); }

  .consulta { display: grid; grid-template-columns: 1fr 1.2fr; gap: clamp(32px, 5vw, 80px); align-items: start; }
  @media (max-width: 900px) { .consulta { grid-template-columns: 1fr; } }
</style>
