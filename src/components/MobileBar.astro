---
import { site, waLink } from '../data/site';
interface Props { waTexto: string }
const { waTexto } = Astro.props;
const wa = waLink(waTexto);
---
<!-- Escritorio: botón flotante de WhatsApp -->
<a class="wa-fab" href={wa} target="_blank" rel="noopener" aria-label="Escríbenos por WhatsApp" data-track="clic_whatsapp" data-ubicacion="flotante">
  <svg viewBox="0 0 32 32" aria-hidden="true"><path fill="currentColor" d="M16 3C9 3 3.3 8.6 3.3 15.6c0 2.4.7 4.7 1.9 6.7L3 29l6.9-2.1c1.9 1 4 1.6 6.1 1.6 7 0 12.7-5.6 12.7-12.6S23 3 16 3Zm0 23.1c-1.9 0-3.8-.5-5.4-1.5l-.4-.2-4.1 1.2 1.3-4-.3-.4a10.4 10.4 0 0 1-1.6-5.6C5.5 9.8 10.2 5.2 16 5.2s10.5 4.6 10.5 10.4S21.8 26.1 16 26.1Zm5.8-7.8c-.3-.2-1.9-.9-2.2-1-.3-.1-.5-.2-.7.2l-1 1.2c-.2.2-.4.2-.7.1a8.6 8.6 0 0 1-4.3-3.7c-.3-.5.3-.5.9-1.6.1-.2 0-.4 0-.5l-1-2.4c-.3-.6-.5-.5-.7-.5h-.6c-.2 0-.6.1-.9.4-.3.3-1.2 1.1-1.2 2.8s1.2 3.2 1.4 3.5c.2.2 2.4 3.6 5.8 5 2.2.9 3 1 4.1.8.7-.1 1.9-.8 2.2-1.5.3-.8.3-1.4.2-1.5-.1-.2-.3-.2-.6-.4Z"/></svg>
</a>

<!-- Móvil: barra inferior fija -->
<nav class="mbar" aria-label="Contacto rápido">
  <a href={site.telefonoHref} data-track="clic_telefono" data-ubicacion="barra_movil">Llamar</a>
  <a href={wa} target="_blank" rel="noopener" class="mbar__wa" data-track="clic_whatsapp" data-ubicacion="barra_movil">WhatsApp</a>
  <a href={site.mapsUrl} target="_blank" rel="noopener" data-track="clic_como_llegar" data-ubicacion="barra_movil">Cómo llegar</a>
</nav>

<style>
  .wa-fab {
    position: fixed; right: 24px; bottom: 24px; z-index: 60;
    width: 60px; height: 60px; border-radius: 50%;
    display: grid; place-items: center;
    background: var(--whatsapp); color: #fff;
    box-shadow: 0 8px 24px rgb(16 30 44 / 0.25);
    transition: transform 0.2s var(--ease);
  }
  .wa-fab:hover { transform: scale(1.06); }
  .wa-fab svg { width: 32px; height: 32px; }

  .mbar { display: none; }
  @media (max-width: 760px) {
    .wa-fab { display: none; }
    .mbar {
      display: grid; grid-template-columns: 1fr 1fr 1fr;
      position: fixed; left: 0; right: 0; bottom: 0; z-index: 60;
      background: var(--tinta); padding-bottom: env(safe-area-inset-bottom);
    }
    .mbar a {
      color: var(--hueso); text-decoration: none; text-align: center;
      padding: 16px 4px; font-size: 0.78rem; letter-spacing: 0.12em; text-transform: uppercase; font-weight: 500;
    }
    .mbar a + a { border-left: 1px solid #2c2925; }
    .mbar__wa { background: var(--whatsapp); color: #08311a !important; }
  }
</style>
