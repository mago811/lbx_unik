---
// Formulario de consulta / reserva de visita → POST /api/contacto → Resend.
// Ver docs/SPECS.md §6.
interface Props { referencia?: string; tipo?: string; titulo?: string }
const { referencia = '', tipo = 'Visita al showroom', titulo = 'Cuéntanos qué buscas' } = Astro.props;
const tipos = ['Visita al showroom', 'Sofás', 'Mobiliario', 'Interiorismo', 'Reformas', 'Otro'];
---
<form class="cf" data-form="contacto" novalidate>
  <h3>{titulo}</h3>
  <div class="cf__row">
    <label>Nombre<input name="nombre" autocomplete="name" required /></label>
    <label>Teléfono<input name="telefono" type="tel" autocomplete="tel" required /></label>
  </div>
  <label>Email<input name="email" type="email" autocomplete="email" /></label>
  <div class="cf__row">
    <label>Tipo de consulta
      <select name="tipo">
        {tipos.map((t) => <option selected={t === tipo}>{t}</option>)}
      </select>
    </label>
    <label>Referencia (si aplica)<input name="referencia" value={referencia} /></label>
  </div>
  <label>Mensaje<textarea name="mensaje" rows="4" placeholder="Medidas del espacio, estilo que te gusta, cuándo te vendría bien venir…"></textarea></label>
  <label class="cf__check"><input type="checkbox" name="privacidad" required /> Acepto la <a href="/legal/privacidad">política de privacidad</a>.</label>
  <input type="text" name="empresa" class="cf__hp" tabindex="-1" autocomplete="off" aria-hidden="true" />
  <button class="btn" type="submit">Enviar consulta</button>
  <p class="cf__ok" hidden>Gracias, hemos recibido tu consulta. Te contestamos lo antes posible.</p>
  <p class="cf__err" role="alert" hidden></p>
</form>

<script>
  import { track } from '../scripts/analitica';
  document.querySelectorAll<HTMLFormElement>('[data-form="contacto"]').forEach((f) =>
    f.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (!f.reportValidity()) return;
      const btn = f.querySelector<HTMLButtonElement>('button[type="submit"]')!;
      const ok = f.querySelector<HTMLElement>('.cf__ok')!;
      const err = f.querySelector<HTMLElement>('.cf__err')!;
      const datos: Record<string, unknown> = Object.fromEntries(new FormData(f));
      datos.privacidad = (f.elements.namedItem('privacidad') as HTMLInputElement).checked;
      datos.pagina = location.pathname;
      const q = new URLSearchParams(location.search);
      datos.utm = ['utm_source', 'utm_medium', 'utm_campaign'].map((k) => q.get(k)).filter(Boolean).join(' / ');

      btn.disabled = true;
      btn.textContent = 'Enviando…';
      err.hidden = true;
      try {
        const res = await fetch('/api/contacto', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(datos),
        });
        const r = await res.json().catch(() => ({}));
        if (!res.ok || !r.ok) throw new Error(r.error || 'No hemos podido enviar tu consulta.');
        track('envio_formulario', { tipo: datos.tipo, ubicacion: location.pathname });
        f.reset();
        ok.hidden = false;
        btn.textContent = 'Enviado';
      } catch (e) {
        err.textContent = (e as Error).message;
        err.hidden = false;
        btn.disabled = false;
        btn.textContent = 'Enviar consulta';
      }
    }),
  );
</script>

<style>
  .cf { display: grid; gap: 22px; color: var(--ink); }
  .cf h3 { font-weight: 320; font-size: clamp(1.8rem, 3vw, 2.8rem); letter-spacing: -0.025em; margin-bottom: 8px; }
  .cf__row { display: grid; grid-template-columns: 1fr 1fr; gap: 22px; }
  @media (max-width: 600px) { .cf__row { grid-template-columns: 1fr; } }
  .cf label { display: grid; gap: 4px; font-size: 0.72rem; letter-spacing: 0.1em; text-transform: uppercase; font-weight: 500; color: var(--ink-soft); }
  .cf input, .cf select, .cf textarea {
    font: 400 1.05rem var(--font-text); color: var(--ink); text-transform: none; letter-spacing: 0;
    padding: 10px 0; background: transparent; border: 0; border-bottom: 1px solid var(--piedra); border-radius: 0;
    transition: border-color 0.25s;
  }
  .cf textarea { resize: vertical; }
  .cf input:focus, .cf select:focus, .cf textarea:focus { outline: none; border-bottom-color: var(--tinta); }
  .cf input:focus-visible, .cf select:focus-visible, .cf textarea:focus-visible { box-shadow: 0 2px 0 0 var(--terracota); }
  .cf__check { display: flex !important; align-items: center; gap: 10px !important; text-transform: none !important; letter-spacing: 0 !important; font-size: 0.9rem !important; font-weight: 400 !important; color: var(--ink) !important; }
  .cf__check input { width: 18px; height: 18px; accent-color: var(--tinta); }
  .cf__hp { position: absolute; left: -9999px; }
  .cf__ok { color: #4f6b3e; margin: 0; }
  .cf__err { color: #a3352b; margin: 0; }
  .cf .btn { justify-self: start; padding: 1.05em 1.8em; }
</style>
