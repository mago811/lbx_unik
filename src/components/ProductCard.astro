---
import { Image } from 'astro:assets';
import type { Producto } from '../data/productos';
import { marcas } from '../data/site';
interface Props { p: Producto }
const { p } = Astro.props;
const marca = marcas.find((m) => m.slug === p.marca)?.nombre;
---
<a href={`/catalogo/${p.slug}`} class="pc" data-tipos={p.tipos.join('|')}>
  <div class="pc__img">
    <Image src={p.portada} alt={`${p.nombre} de ${marca}`} width={800} widths={[480, 800]} quality={75} sizes="(max-width: 600px) 100vw, (max-width: 960px) 50vw, 33vw" class="cover" />
  </div>
  <div class="pc__txt">
    <span class="pc__marca">{marca}</span>
    <h3>{p.nombre}</h3>
    <span class="pc__tipos">{p.tipos.join(' · ')}</span>
  </div>
</a>

<style>
  .pc { text-decoration: none; display: block; }
  .pc__img { aspect-ratio: 4 / 3; overflow: hidden; background: var(--blanco-roto); }
  .pc__img :global(img) { transition: transform 1.2s var(--ease-out); }
  .pc:hover .pc__img :global(img) { transform: scale(1.035); }
  .pc__txt { display: grid; grid-template-columns: 1fr auto; align-items: baseline; gap: 4px 16px; padding-top: 14px; }
  .pc h3 { margin: 0; font-weight: 320; font-size: clamp(1.7rem, 2.6vw, 2.6rem); letter-spacing: -0.03em; grid-column: 1; grid-row: 1; transition: color 0.3s; }
  .pc:hover h3 { color: var(--terracota); font-style: italic; }
  .pc__marca { font-size: 0.75rem; color: var(--ink-soft); grid-column: 2; grid-row: 1; text-align: right; }
  .pc__tipos { font-size: 0.85rem; color: var(--ink-soft); grid-column: 1 / -1; }
</style>
