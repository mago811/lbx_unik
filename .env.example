# Resend (https://resend.com) — formulario de contacto
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxx
# Quién recibe las consultas (separar varios con coma)
CONTACT_TO=hola@uniksofas.es
# Remitente. Hasta verificar el dominio en Resend usar: UNIK Web <onboarding@resend.dev>
CONTACT_FROM=UNIK Web <web@uniksofas.es>

# Medición (opcional). Sin estos IDs no se carga ningún script de terceros ni aparece el banner de cookies.
# Google Analytics 4 → Administrar → Flujos de datos → ID de medición (G-XXXXXXXXXX)
PUBLIC_GA4_ID=
# Meta → Administrador de eventos → ID del píxel (solo números)
PUBLIC_META_PIXEL_ID=
